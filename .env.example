# ============================================================
# AMS Agentes - Variables de entorno
# Copia este archivo a .env y completa los valores.
# ============================================================

# --- Huawei Cloud MaaS (GLM) ---
# Endpoint compatible con OpenAI (chat/completions)
MAAS_ENDPOINT=https://api-ap-southeast-1.modelarts-maas.com/v2/chat/completions
# Nombre del modelo GLM desplegado en MaaS
MAAS_MODEL=
# API key de MaaS (NO la subas al repositorio)
MAAS_API_KEY=
# Timeout de la llamada HTTP, en segundos
MAAS_TIMEOUT=300
# Temperatura del modelo (recomendado 0.1 - 0.2)
MAAS_TEMPERATURE=0.2
# Verificar el certificado SSL del endpoint (true | false)
MAAS_VERIFY_SSL=true

# --- Modo de LLM ---
# maas = llamadas reales a MaaS
# fake = respuestas simuladas para pruebas sin clave
LLM_MODE=maas

# --- Orquestador ---
# Concurrencia maxima para la ingesta por fuente
INGEST_CONCURRENCY=4
# Maximo de llamadas a tools por agente
MAX_TOOL_CALLS=5
# Revision humana cuando rca.needs_human_review = true
# pause  = detener antes de Resolucion
# continue = seguir el flujo
HUMAN_REVIEW=pause

# --- Expedientes ---
# Directorio donde se guardan los expedientes de los casos
CASES_DIR=cases
